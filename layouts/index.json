{{- $list := slice -}}
{{- range (where .Site.Pages "Kind" "in" (slice "page" "section")) -}}
  {{- if and .Content (not .Params.noindex) -}}
  {{- $summary := .Summary | plainify }}
  {{- $plain := .Plain | replaceRE "\\s+" " " }}
  {{- /* Keep search snippets as the page shows them; see straight_quotes in single.html. */ -}}
  {{- if .Params.straight_quotes }}
    {{- $summary = $summary | replaceRE "&[lr]squo;|[‘’]" "'" | replaceRE "&[lr]dquo;|[“”]" "\"" }}
    {{- $plain = $plain | replaceRE "&[lr]squo;|[‘’]" "'" | replaceRE "&[lr]dquo;|[“”]" "\"" }}
  {{- end }}
  {{- $list = $list | append (dict
      "title" .Title
      "url" .RelPermalink
      "section" .Section
      "tags" (or .Params.tags slice)
      "settings" (or .Params.settings slice)
      "date" (cond .Date.IsZero "" (.Date.Format "2 January 2006"))
      "summary" ($summary | safeHTML | truncate 180)
      "content" $plain
  ) -}}
  {{- end -}}
{{- end -}}
{{- $list | jsonify -}}
